    div(style=sprintf("background:#dbeafe;padding:8px;border-radius:6px;border-left:4px solid %s;",COLORS$primary),
      p(strong(sprintf("Selected: %d trees | mtry=%d | node=%d", bp$num_trees, bp$mtry, bp$min_node_size)),
        style="font-size:12px;margin:0;color:#1e3a8a;"),
      p(sprintf("OOB RMSE=$%.4fM | Test RMSE=$%.4fM | MAPE=%.2f%%",
                bp$oob_rmse, bp$test_rmse, bp$test_mape),
        style="font-size:11px;margin:2px 0 0;color:#3730a3;")
    )
  })

  output$rf_plot_mtry <- renderPlot({
    if(!HAS_RF || is.null(rf_results$mtry_effect)) return(NULL)
    bp <- rf_results$best_params
    ggplot(rf_results$mtry_effect, aes(x=factor(mtry), y=avg_oob)) +
      geom_col(fill=COLORS$rf_color, alpha=0.8) +
      geom_vline(xintercept=as.character(bp$mtry), color=COLORS$accent1, linetype="dashed", size=1.2) +
      labs(x="mtry", y="Avg OOB RMSE ($M)") + theme_cfb(10)
  })
  output$rf_plot_trees <- renderPlot({
    if(!HAS_RF || is.null(rf_results$trees_effect)) return(NULL)
    bp <- rf_results$best_params
    ggplot(rf_results$trees_effect, aes(x=num_trees, y=avg_oob)) +
      geom_line(color=COLORS$rf_color, size=1.2) + geom_point(color=COLORS$rf_color, size=2.5) +
      geom_vline(xintercept=bp$num_trees, color=COLORS$accent1, linetype="dashed") +
      labs(x="Num Trees", y="Avg OOB RMSE ($M)") + theme_cfb(10)
  })
  output$rf_plot_nodesize <- renderPlot({
    if(!HAS_RF || is.null(rf_results$nodesize_effect)) return(NULL)
    bp <- rf_results$best_params
    ggplot(rf_results$nodesize_effect, aes(x=factor(min_node_size), y=avg_oob)) +
      geom_col(fill="#0f766e", alpha=0.8) +
      geom_vline(xintercept=as.character(bp$min_node_size), color=COLORS$accent1, linetype="dashed", size=1.2) +
      labs(x="Min Node Size", y="Avg OOB RMSE ($M)") + theme_cfb(10)
  })

  output$rf_table_importance <- renderDT({
    if(!HAS_RF) return(NULL)
    rf_results$vi_df %>%
      mutate(Importance=round(Importance,1), `% of Max`=sprintf("%.1f%%", Importance/max(Importance)*100)) %>%
      select(Rank, Feature, Importance, `% of Max`) %>%
      datatable(rownames=FALSE, options=list(pageLength=13, dom='t')) %>%
      formatStyle("Rank", backgroundColor=styleInterval(c(3,6), c("#d1fae5","#ecfdf5","white")),
                  fontWeight=styleInterval(c(1), c("bold","normal")))
  })

  output$rf_plot_importance <- renderPlot({
    if(!HAS_RF) return(NULL)
    rf_results$vi_df %>% head(10) %>%
      mutate(Feature=fct_reorder(Feature, Importance)) %>%
      ggplot(aes(x=Importance, y=Feature, fill=Importance)) +
      geom_col() + scale_fill_gradient(low=COLORS$secondary, high=COLORS$rf_color, guide="none") +
      labs(x="Permutation Importance", y=NULL) + theme_cfb(10)
  })

  output$rf_plot_pdp <- renderPlot({
    if(!HAS_RF) return(NULL)
    pd <- rf_results$pd_rank
    ggplot(pd, aes(x=rank_pct, y=avg_revenue)) +
      geom_line(color=COLORS$rf_color, size=1.3) +
      geom_ribbon(aes(ymin=avg_revenue*0.93, ymax=avg_revenue*1.07), alpha=0.15, fill=COLORS$rf_color) +
      geom_vline(xintercept=c(45/134,90/134), linetype="dashed", color=COLORS$accent1, alpha=0.8) +
      annotate("text",x=45/134,y=max(pd$avg_revenue)*0.95,label="T1|T2",hjust=-0.1,color=COLORS$accent1,size=2.8) +
      annotate("text",x=90/134,y=max(pd$avg_revenue)*0.88,label="T2|T3",hjust=-0.1,color=COLORS$accent1,size=2.8) +
      scale_x_continuous(labels=scales::percent) + scale_y_continuous(labels=function(x) paste0("$", formatC(x, format="f", digits=0), "M")) +
      labs(x="Rank Percentile (0%=best)", y="Avg Revenue ($M)") + theme_cfb(10)
  })

  output$rf_pdp_stats <- renderUI({
    if(!HAS_RF) return(NULL)
    pd <- rf_results$pd_rank
    spread <- pd$avg_revenue[1] - pd$avg_revenue[nrow(pd)]
    div(style="background:#f0f4ff;padding:6px;border-radius:5px;margin-top:4px;",
      p(sprintf("Best: $%.1fM | Worst: $%.1fM | Spread: $%.1fM",
                pd$avg_revenue[1], pd$avg_revenue[nrow(pd)], spread),
        style="font-size:11px;margin:0;color:#1e3a8a;"))
  })

  output$rf_vs_lm_table <- renderDT({
    if(!HAS_RF || !HAS_LM) return(NULL)
    lm_rmse <- if(!is.null(lm_results$all_metrics))
      lm_results$all_metrics$Test_RMSE[lm_results$all_metrics$Model=="M5: Full (13 features)"][1]
    else lm_results$test_metrics$RMSE_M[1]
    lm_mape <- if(!is.null(lm_results$all_metrics))
      lm_results$all_metrics$Test_MAPE[lm_results$all_metrics$Model=="M5: Full (13 features)"][1]
    else lm_results$test_metrics$MAPE_pct[1]
    lm_r2 <- if(!is.null(lm_results$all_metrics))
      lm_results$all_metrics$Test_R2[lm_results$all_metrics$Model=="M5: Full (13 features)"][1]
    else NA
    rf_r2   <- if(nrow(rf_results$rf_metrics)>=2) rf_results$rf_metrics$R2[2] else rf_results$rf_metrics$R2[1]
    rf_rmse <- if(nrow(rf_results$rf_metrics)>=2) rf_results$rf_metrics$RMSE_M[2] else rf_results$rf_metrics$RMSE_M[1]
    rf_mape <- if(nrow(rf_results$rf_metrics)>=2) rf_results$rf_metrics$MAPE_pct[2] else rf_results$rf_metrics$MAPE_pct[1]
    tibble(
      Metric=c("Test R²","Test RMSE","Test MAPE","Interpretable?","Non-linear?"),
      `Lin Reg`=c(sprintf("%.4f",lm_r2), sprintf("$%.2fM",lm_rmse), sprintf("%.2f%%",lm_mape), "Yes (coefs)", "No"),
      `Rand Forest`=c(sprintf("%.4f",rf_r2), sprintf("$%.2fM",rf_rmse), sprintf("%.2f%%",rf_mape), "Partial (VI)", "Yes")
    ) %>% datatable(rownames=FALSE, options=list(dom='t', pageLength=6))
  })

  output$rf_table_default_vs_optimal <- renderDT({
    if(!HAS_RF) return(NULL)
    rf_results$rf_metrics %>%
      mutate(across(where(is.numeric), ~round(.,4))) %>%
      datatable(rownames=FALSE, options=list(dom='t', pageLength=3)) %>%
      formatStyle(0, target='row', backgroundColor=styleRow(2,"#dbeafe"), fontWeight=styleRow(2,"bold"))
  })

  output$rf_tuning_gain <- renderUI({
    if(!HAS_RF || is.null(rf_results$tuning_gain_rmse)) return(NULL)
    gain <- rf_results$tuning_gain_rmse
    div(style="background:#d1fae5;padding:8px;border-radius:6px;border-left:4px solid #059669;margin-top:6px;",
      p(strong(sprintf("Tuning gain: %.2f%% lower RMSE", gain)), style="font-size:12px;margin:0;color:#065f46;"),
      p("vs. default sqrt(p) mtry, 500 trees, node.size=5", style="font-size:10px;margin:1px 0 0;color:#047857;"))
  })

  output$rf_plot_actual_pred <- renderPlot({
    if(!HAS_RF || !HAS_LM) return(NULL)
    test_rf_df <- lm_results$model_data %>% filter(year>=2023) %>%
      mutate(conference=as.factor(conference), tier_proxy=as.factor(tier_proxy))
    tryCatch({
      preds <- predict(rf_results$best_model, data=test_rf_df %>% select(all_of(rf_results$features)))$predictions
      test_rf_df %>% mutate(predicted=preds) %>%
        ggplot(aes(x=revenue, y=predicted, color=as.character(tier_proxy))) +
        geom_point(alpha=0.65, size=1.8) +
        geom_abline(slope=1, intercept=0, linetype="dashed", color="gray40") +
        scale_color_manual(values=c("1"=COLORS$primary,"2"=COLORS$secondary,"3"=COLORS$accent1),
                           labels=c("Tier 1","Tier 2","Tier 3"), name="Tier") +
        scale_x_continuous(labels=function(x) paste0("$", formatC(x, format="f", digits=0), "M")) +
        scale_y_continuous(labels=function(x) paste0("$", formatC(x, format="f", digits=0), "M")) +
        labs(title="RF Optimal: Actual vs. Predicted", x="Actual ($M)", y="Predicted ($M)") + theme_cfb(11)
    }, error=function(e) NULL)
  })

  output$rf_plot_projection <- renderPlot({
    if(!HAS_RF) return(NULL)
    ggplot(rf_results$national %>% mutate(rev_B = total_revenue/1000), aes(x=year, y=rev_B)) +
      geom_line(color=COLORS$rf_color, size=1.2) + geom_point(color=COLORS$rf_color, size=2.5) +
      annotate("text", x=2034, y=max(rf_results$national$total_revenue)/1000,
               label=sprintf("CAGR: %.2f%%", rf_results$cagr*100),
               hjust=1.1, color=COLORS$rf_color, fontface="bold", size=3.8) +
      scale_y_continuous(labels=function(x) paste0("$", formatC(x, format="f", digits=1), "B")) + scale_x_continuous(breaks=2025:2034) +
      labs(title="RF: National Revenue 2025-2034", x="Year", y="Revenue ($B)") + theme_cfb(11)
  })

  # ────────────────────────────────────────
  # TAB 11: MODEL COMPARISON OUTPUTS  ← NEW
  # ────────────────────────────────────────

  output$comp_plot_projections <- renderPlot({
    if(!HAS_COMP) return(NULL)
    ggplot(all_projections %>% mutate(rev_B = total_revenue / 1000), aes(x = year, y = rev_B, color = model, linetype = model)) +
      geom_line(size = 1.3) + geom_point(size = 2.5) +
      scale_color_manual(values = model_colors, name = "Model") +
      scale_linetype_manual(
        values = c("Monte Carlo (Baseline)"   = "dashed",
                   "Monte Carlo (Relegation)" = "solid",
                   "Linear Regression"        = "solid",
                   "Random Forest"            = "solid"),
        name = "Model"
      ) +
      scale_y_continuous(labels = function(x) paste0("$", formatC(x, format="f", digits=1), "B")) +
      scale_x_continuous(breaks = 2025:2034) +
      labs(title = "All Models: National Revenue Projections",
           subtitle = "Monte Carlo simulates relegation policy; LR & RF trained on 2017-2022 historical data",
           x = "Year", y = "Total FBS Revenue ($B)",
           caption = "Sources: NCAA financial data 2015-2024 | Monte Carlo: 100 simulation runs") +
      theme_cfb(13) + theme(axis.text.x = element_text(angle = 45, hjust = 1))
  })

  output$comp_plot_cagr <- renderPlot({
    if(!HAS_COMP) return(NULL)
    cagr_data <- all_projections %>%
      group_by(model) %>% arrange(year) %>%
      summarize(cagr_pct = ((last(total_revenue) / first(total_revenue))^(1/9) - 1) * 100, .groups = "drop")
    ggplot(cagr_data, aes(x = fct_reorder(model, cagr_pct), y = cagr_pct, fill = model)) +
      geom_col(show.legend = FALSE) +
      geom_text(aes(label = sprintf("%.2f%%", cagr_pct)), vjust = -0.4, fontface = "bold", size = 4) +
      scale_fill_manual(values = model_colors) +
      scale_y_continuous(labels = function(x) paste0(x, "%"), expand = expansion(mult = c(0, 0.15))) +
      labs(title = "CAGR Comparison (2025-2034)", x = NULL, y = "Projected CAGR (%)") +
      theme_cfb(13) + theme(axis.text.x = element_text(angle = 20, hjust = 1))
  })

  output$comp_plot_accuracy <- renderPlot({
    if(!HAS_LM || !HAS_RF) return(NULL)
    acc_data <- bind_rows(
      lm_results$test_metrics %>% filter(Model == "Full model") %>%
        mutate(Model = "Linear Regression"),
      rf_results$rf_metrics %>% filter(Model == "RF Tuned (1000 trees, mtry=4)") %>%
        mutate(Model = "Random Forest")
    ) %>%
      select(Model, R2, RMSE_M, MAPE_pct) %>%
      pivot_longer(-Model, names_to = "Metric", values_to = "Value") %>%
      mutate(Metric = recode(Metric,
                             "R2"       = "R² (higher = better)",
                             "RMSE_M"   = "RMSE $M (lower = better)",
                             "MAPE_pct" = "MAPE % (lower = better)"))
    ggplot(acc_data, aes(x = Model, y = Value, fill = Model)) +
      geom_col(show.legend = FALSE) +
      geom_text(aes(label = round(Value, 2)), vjust = -0.4, size = 3.5) +
      scale_fill_manual(values = c("Linear Regression" = COLORS$lm_color, "Random Forest" = COLORS$rf_color)) +
      scale_y_continuous(expand = expansion(mult = c(0, 0.20))) +
      facet_wrap(~Metric, scales = "free_y") +
      labs(title = "LR vs RF: Predictive Accuracy", subtitle = "Test set 2023-2024",
           x = NULL, y = NULL) +
      theme_cfb(12) + theme(axis.text.x = element_text(angle = 15, hjust = 1))
  })

  output$comp_table_summary <- renderDT({
    if(!HAS_COMP) return(datatable(tibble(Message = "Run MODEL_COMPARISON.R first")))
    datatable(comparison_table, rownames = FALSE,
              options = list(pageLength = 5, dom = 't')) %>%
      formatStyle('Model',
                  backgroundColor = styleEqual(
                    c("Monte Carlo (Relegation)", "Linear Regression", "Random Forest",
                      "Monte Carlo (Baseline)"),
                    c('#f0fdf4', '#fff7ed', '#f5f3ff', '#eff6ff')
                  ))
  })

}

