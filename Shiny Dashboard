  ),

  # =============================
  # TAB 11: MODEL COMPARISON  ← NEW
  # =============================

  tabPanel("Model Comparison",
    fluidRow(
      column(12,
        h2("Three-Model Comparison", style = sprintf("color: %s; margin-bottom: 5px;", COLORS$primary)),
        p("Monte Carlo Simulation vs Linear Regression vs Random Forest — each answers a different question.",
          style = sprintf("color: %s; font-size: 15px; margin-bottom: 25px;", COLORS$neutral))
      )
    ),

    # Model role cards
    fluidRow(
      column(4,
        div(style = sprintf("border: 2px solid %s; border-radius: 8px; padding: 20px;", COLORS$relegation),
          h4("Monte Carlo", style = sprintf("color: %s; margin-top: 0;", COLORS$relegation)),
          p(strong("Question:"), " What happens to the system under relegation vs baseline over 10 years?"),
          p(strong("Method:"), " Stochastic simulation, 100 runs × 5 scenarios"),
          p(strong("Strength:"), " Models policy scenarios, uncertainty, system dynamics"),
          p(strong("Limitation:"), " Relies on assumed/calibrated parameters")
        )
