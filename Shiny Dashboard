# ===========================
# SERVER
# ===========================

server <- function(input, output, session) {

  # ────────────────────────────────────────
  # ORIGINAL TABS 1-8 (unchanged)
  # ────────────────────────────────────────

  output$hero_intensity <- renderUI({
    if(!HAS_METRICS) return(h1("Calculating..."))
    baseline_int <- metrics$summary_stats$intensity_comparison %>%
      filter(grepl("baseline", scenario_id)) %>% pull(avg_intensity) %>% mean()
    releg_int <- metrics$summary_stats$intensity_comparison %>%
      filter(grepl("releg", scenario_id)) %>% pull(avg_intensity) %>% mean()
    multiplier <- releg_int / baseline_int
    div(h1(sprintf("%.1f%%", releg_int), style = "font-size: 48px; margin: 10px 0;"),
        p(sprintf("vs %.1f%% baseline", baseline_int), style = "font-size: 18px;"),
        h4(sprintf("%.1f× MORE", multiplier), style = "margin-top: 15px; font-weight: bold;"))
  })

  output$hero_growth <- renderUI({
    if(!HAS_METRICS) return(h1("Calculating..."))
    baseline_cagr <- metrics$summary_stats$overall_summary %>%
      filter(grepl("baseline", scenario_id)) %>% pull(cagr) %>% mean(na.rm = TRUE)
    releg_cagr <- metrics$summary_stats$overall_summary %>%
      filter(grepl("releg", scenario_id)) %>% pull(cagr) %>% mean(na.rm = TRUE)
    diff <- releg_cagr - baseline_cagr
    div(h1(sprintf("%.2f%%", releg_cagr), style = "font-size: 48px; margin: 10px 0;"),
        p(sprintf("vs %.2f%% baseline", baseline_cagr), style = "font-size: 18px;"),
        h4(sprintf("+%.2f%% FASTER", diff), style = "margin-top: 15px; font-weight: bold;"))
  })

  output$hero_gini <- renderUI({
    if(!HAS_METRICS) return(h1("Calculating..."))
    baseline_gini <- metrics$summary_stats$gini_comparison %>%
      filter(grepl("baseline", scenario_id)) %>% pull(avg_gini) %>% mean()
    releg_gini <- metrics$summary_stats$gini_comparison %>%
      filter(grepl("releg", scenario_id)) %>% pull(avg_gini) %>% mean()
    change_pct <- abs((releg_gini - baseline_gini) / baseline_gini * 100)
    label_text <- ifelse(releg_gini > baseline_gini, "MERIT-BASED", "MORE EQUAL")
    div(h1(sprintf("%.3f", releg_gini), style = "font-size: 48px; margin: 10px 0;"),
        p(sprintf("vs %.3f baseline", baseline_gini), style = "font-size: 18px;"),
        h4(sprintf("+%.0f%% %s", change_pct, label_text), style = "margin-top: 15px; font-weight: bold;"))
  })

  output$plot_mobility <- renderPlot({
    if(!HAS_METRICS) return(NULL)
    mobility_data <- metrics$scenario_mobility %>%
      mutate(system = ifelse(grepl("baseline", scenario_id), "Baseline", "Relegation"))
    ggplot(mobility_data, aes(x = reorder(scenario_id, pct_ever_moved), y = pct_ever_moved, fill = system)) +
      geom_col(width = 0.7) + coord_flip() +
      scale_fill_manual(values = c("Baseline" = COLORS$baseline, "Relegation" = COLORS$relegation)) +
      labs(title = "Competitive Mobility", subtitle = "% of teams changing tiers",
           x = NULL, y = "% Teams Moved", fill = NULL) +
      theme_cfb(12) + theme(legend.position = "none")
  })

  output$plot_late_season <- renderPlot({
    if(!HAS_METRICS) return(NULL)
    late_data <- metrics$late_season_intensity %>%
      mutate(system = ifelse(grepl("baseline", scenario_id), "Baseline", "Relegation"))
    ggplot(late_data, aes(x = reorder(scenario_id, teams_meaningful), y = teams_meaningful, fill = system)) +
      geom_col(width = 0.7) + coord_flip() +
      scale_fill_manual(values = c("Baseline" = COLORS$baseline, "Relegation" = COLORS$relegation)) +
      labs(title = "Late-Season Relevance", subtitle = "Teams with meaningful games (Years 4-10)",
           x = NULL, y = "# Teams", fill = NULL) +
      theme_cfb(12) + theme(legend.position = "none")
  })

  output$plot_sustainability <- renderPlot({
    start_revenues <- team %>% filter(year == 2025) %>%
      distinct(team, .keep_all = TRUE) %>% select(team, start_rev = revenue)
    sustainability_data <- team %>%
      left_join(start_revenues, by = "team", relationship = "many-to-one") %>%
      mutate(at_floor = revenue <= (start_rev * 0.41)) %>%
      group_by(scenario_id, year) %>%
      summarise(pct_at_floor = mean(at_floor, na.rm = TRUE) * 100, .groups = "drop") %>%
      group_by(scenario_id) %>%
      summarise(avg_at_floor = mean(pct_at_floor, na.rm = TRUE)) %>%
      mutate(system = ifelse(grepl("baseline", scenario_id), "Baseline", "Relegation"))
    ggplot(sustainability_data, aes(x = reorder(scenario_id, -avg_at_floor), y = avg_at_floor, fill = system)) +
      geom_col(width = 0.7) + coord_flip() +
      scale_fill_manual(values = c("Baseline" = COLORS$baseline, "Relegation" = COLORS$relegation)) +
      labs(title = "Financial Sustainability", subtitle = "% teams at revenue floor",
           x = NULL, y = "% At Floor", fill = NULL) +
      theme_cfb(12) + theme(legend.position = "none")
  })

  output$verdict_text <- renderUI({
    if(!HAS_METRICS) return(p("Calculating..."))
    tryCatch({
      baseline_int  <- metrics$summary_stats$intensity_comparison %>% filter(grepl("baseline", scenario_id)) %>% pull(avg_intensity) %>% mean(na.rm=TRUE)
      releg_int     <- metrics$summary_stats$intensity_comparison %>% filter(grepl("releg",    scenario_id)) %>% pull(avg_intensity) %>% mean(na.rm=TRUE)
      baseline_cagr <- metrics$summary_stats$overall_summary     %>% filter(grepl("baseline", scenario_id)) %>% pull(cagr)           %>% mean(na.rm=TRUE)
      releg_cagr    <- metrics$summary_stats$overall_summary     %>% filter(grepl("releg",    scenario_id)) %>% pull(cagr)           %>% mean(na.rm=TRUE)
      baseline_gini <- metrics$summary_stats$gini_comparison     %>% filter(grepl("baseline", scenario_id)) %>% pull(avg_gini)       %>% mean(na.rm=TRUE)
      releg_gini    <- metrics$summary_stats$gini_comparison     %>% filter(grepl("releg",    scenario_id)) %>% pull(avg_gini)       %>% mean(na.rm=TRUE)
      mobility_pct  <- metrics$scenario_mobility                 %>% filter(grepl("releg",    scenario_id)) %>% pull(pct_ever_moved) %>% mean(na.rm=TRUE)
      intensity_multiplier <- releg_int / baseline_int
      growth_diff   <- releg_cagr - baseline_cagr
      gini_change_pct <- abs((releg_gini - baseline_gini) / baseline_gini * 100)
      gini_text <- ifelse(releg_gini > baseline_gini,
                          sprintf("<strong>merit-based inequality</strong> (+%.1f%% higher Gini, earned through performance)", gini_change_pct),
                          sprintf("<strong>%.1f%% more equitable</strong> distribution", gini_change_pct))
      HTML(sprintf("
        <p style='font-size: 16px; line-height: 1.8;'>
          The relegation system produces a <strong>superior competitive product</strong>:
        </p>
        <ul style='font-size: 15px; line-height: 1.8;'>
          <li><strong>%.1f× more competitive games</strong> (%.1f%% vs %.1f%% of teams with meaningful late-season games)</li>
          <li><strong>%.2f percentage points faster revenue growth</strong> (%.2f%% vs %.2f%% CAGR)</li>
          <li><strong>%s</strong> (Gini: %.3f vs %.3f)</li>
          <li><strong>%.0f%% of teams change tiers</strong> over 10 years based on performance</li>
        </ul>
        <p style='font-size: 16px; margin-top: 20px;'>
          <strong>Conclusion:</strong> Relegation delivers a superior product for fans, competitive balance for teams, and sustainable long-term growth.
        </p>
      ", intensity_multiplier, releg_int, baseline_int, growth_diff,
         releg_cagr, baseline_cagr, gini_text, releg_gini, baseline_gini, mobility_pct))
    }, error = function(e) p("Error calculating verdict.", style = "color: red;"))
  })

  output$plot_revenue_trends <- renderPlotly({
    req(input$rev_scenarios)
    if(length(input$rev_scenarios) == 0) return(NULL)
    plot_data <- national %>%
      filter(scenario_id %in% input$rev_scenarios) %>%
      arrange(scenario_id, year) %>%
      group_by(scenario_id) %>%
      mutate(
        total_rev_billions    = total_revenue / 1000,
        avg_per_team_billions = total_revenue / 134 / 1000,
        growth_rate = if_else(row_number() > 1, (total_revenue / lag(total_revenue) - 1) * 100, NA_real_)
      ) %>% ungroup()
    if(input$rev_metric == "total_revenue") {
      plot_data <- plot_data %>% mutate(value = total_rev_billions); y_label <- "Total Revenue ($B)"
    } else if(input$rev_metric == "avg_per_team") {
      plot_data <- plot_data %>% mutate(value = avg_per_team_billions); y_label <- "Avg Revenue per Team ($B)"
    } else {
      plot_data <- plot_data %>% mutate(value = growth_rate); y_label <- "Year-over-Year Growth (%)"
    }
    plot_data <- plot_data %>% filter(!is.na(value), is.finite(value))
    if(nrow(plot_data) == 0) return(NULL)
    plot_ly(data = plot_data, x = ~year, y = ~value, color = ~scenario_id,
            colors = scenario_colors, type = 'scatter', mode = 'lines+markers',
            line = list(width = 3), marker = list(size = 8),
            hovertemplate = paste('<b>%{fullData.name}</b><br>Year: %{x}<br>', y_label, ': %{y:.2f}<br><extra></extra>')) %>%
      layout(xaxis = list(title = ""), yaxis = list(title = y_label),
             legend = list(orientation = "h", yanchor = "bottom", y = -0.3, xanchor = "center", x = 0.5),
             hovermode = "closest")
  })

  output$plot_components <- renderPlot({
    component_data <- national %>%
      filter(year == 2034) %>%
      select(scenario_id, rev_media, rev_ticket, rev_don, rev_fee, rev_other, rev_bonuses) %>%
      pivot_longer(cols = starts_with("rev_"), names_to = "component", values_to = "revenue") %>%
      mutate(component = case_when(
        component == "rev_media"   ~ "Media Rights",  component == "rev_ticket"  ~ "Ticket Sales",
        component == "rev_don"     ~ "Donations",     component == "rev_fee"     ~ "Student Fees",
        component == "rev_other"   ~ "Other Revenue", component == "rev_bonuses" ~ "Playoff Bonuses"
      ), revenue_billions = revenue / 1000)
    ggplot(component_data, aes(x = scenario_id, y = revenue_billions, fill = component)) +
      geom_col(position = "stack") + coord_flip() +
      scale_fill_viridis_d(option = "turbo") +
      labs(title = "Revenue Sources by Scenario (2034)", x = NULL, y = "Revenue ($B)", fill = "Component") +
      theme_cfb(14)
  })

  output$plot_intensity_heatmap <- renderPlot({
    top_teams <- team %>% filter(grepl("releg_T3_P12", scenario_id)) %>%
      group_by(team) %>% summarise(avg_rev = mean(revenue, na.rm = TRUE)) %>%
      arrange(desc(avg_rev)) %>% slice(1:30) %>% pull(team)
    heatmap_data <- team %>% filter(scenario_id == "releg_T3_P12", team %in% top_teams) %>%
      select(team, year, intensity)
    ggplot(heatmap_data, aes(x = year, y = reorder(team, intensity), fill = intensity)) +
      geom_tile(color = "white", size = 0.5) +
      scale_fill_viridis_c(option = "magma", labels = scales::percent) +
      labs(title = "Intensity Heatmap: Top 30 Teams (Relegation 12-team playoff)",
           x = NULL, y = NULL, fill = "Intensity") +
      theme_minimal(base_size = 12) + theme(axis.text.y = element_text(size = 9), legend.position = "right")
  })

