          p(strong("Question:"), " Which features drive team revenue, and by how much?"),
          p(strong("Method:"), " OLS regression, trained on historical NCAA data"),
          p(strong("Strength:"), " Interpretable coefficients, quantifies each driver's $ impact"),
          p(strong("Limitation:"), " Assumes linear relationships; misses feature interactions")
        )
      ),
      column(4,
        div(style = sprintf("border: 2px solid %s; border-radius: 8px; padding: 20px;", COLORS$rf_color),
          h4("Random Forest", style = sprintf("color: %s; margin-top: 0;", COLORS$rf_color)),
          p(strong("Question:"), " Can we predict team revenue with high accuracy?"),
          p(strong("Method:"), " Ensemble of 1000 decision trees, same features as LR"),
          p(strong("Strength:"), " Captures non-linear patterns; robust to outliers"),
