# Shared theme for ML plots
theme_cfb <- function(base_size = 13) {
  theme_minimal(base_size = base_size) +
    theme(
      plot.title    = element_text(face = "bold", color = COLORS$primary, size = base_size + 1),
      plot.subtitle = element_text(color = COLORS$neutral, size = base_size - 1),
      legend.position = "bottom"
    )
}

